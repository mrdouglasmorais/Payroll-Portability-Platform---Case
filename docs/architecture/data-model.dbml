// Payroll Portability — dual PostgreSQL data model
// Source of truth: Flyway under apps/*/src/main/resources/db/migration
// Published diagram: https://dbdiagram.io/e/6b07b78d6514799802110cd1/6b07b83365147998021115fe
// Platform DB (portability) ≠ Central DB (central) — no shared transactions / cross-DB FKs.
// Schemas below are documentation namespaces (logical DBs), not Postgres SCHEMA objects.
// Monetary: NUMERIC(19,2). Event time: timestamptz UTC.

Project payroll_portability {
  database_type: 'PostgreSQL'
  Note: '''
    Dual-database lab model (ADR-003).
    Author: Douglas Morais (mrdouglasmorais).
    Notion: https://app.notion.com/p/424e56450c38818bb71fc51de037a438
    Diagram: https://dbdiagram.io/e/6b07b78d6514799802110cd1/6b07b83365147998021115fe
    platform.* = Compose platform-db / JDBC portability
    central.*  = Compose central-db / Central simulator
    Logical links (not FKs): external_installment_id, central_protocol / protocol, correlation_id.
  '''
}

// =============================================================================
// platform.* — Flyway V2–V4 (live verified 2026-11-26)
// =============================================================================

TableGroup platform_db [color: #3B82F6] {
  Note: 'Compose service platform-db'
  platform.beneficiaries
  platform.consents
  platform.installment_snapshots
  platform.portability_operations
  platform.operation_installments
  platform.installment_reservations
  platform.operation_events
  platform.idempotency_keys
  platform.processing_jobs
}

Table platform.beneficiaries {
  id uuid [pk]
  external_ref text [not null, unique, note: 'Synthetic beneficiary id (e.g. ben-ui)']
  display_name text [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table platform.consents {
  id uuid [pk]
  beneficiary_id uuid [not null, ref: > platform.beneficiaries.id]
  agreement_id text [not null]
  authorization_id text [unique, note: 'Set when ACCEPTED']
  status text [not null, note: 'PENDING | ACCEPTED | REJECTED']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'CHECK: ACCEPTED requires authorization_id. Partial unique active consent per agreement.'

  Indexes {
    (beneficiary_id, agreement_id) [unique, name: 'uq_consents_active_agreement', note: 'WHERE status IN (PENDING, ACCEPTED)']
  }
}

Table platform.installment_snapshots {
  id uuid [pk]
  external_installment_id text [not null, unique, note: 'Central parcela id']
  beneficiary_id uuid [not null, ref: > platform.beneficiaries.id]
  agreement_id text [not null]
  amount numeric(19,2) [not null, note: 'CHECK amount >= 0']
  discount_date date [not null]
  status text [not null, note: 'OPEN | RESERVED | PORTED | CLOSED']
  effective_bank text [note: 'Vigente; update only on verified CONFIRMADA (V3)']
  effective_agency text
  effective_account text
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (beneficiary_id, agreement_id) [name: 'idx_installments_beneficiary']
  }
}

Table platform.portability_operations {
  id uuid [pk]
  beneficiary_id uuid [not null, ref: > platform.beneficiaries.id]
  assignee_creditor text [not null]
  receiving_bank text [not null]
  receiving_agency text [not null]
  receiving_account text [not null]
  business_status text [not null, note: 'PENDENTE | CONFIRMADA | REJEITADA']
  rejection_reason text [note: 'Required when REJEITADA']
  central_protocol text [unique, note: 'Attached after Central 202']
  correlation_id text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table platform.operation_installments {
  operation_id uuid [not null, ref: > platform.portability_operations.id]
  installment_id uuid [not null, ref: > platform.installment_snapshots.id]
  external_installment_id text [not null]

  Indexes {
    (operation_id, installment_id) [pk]
  }
}

Table platform.installment_reservations {
  id uuid [pk]
  external_installment_id text [not null]
  operation_id uuid [not null, ref: > platform.portability_operations.id]
  status text [not null, note: 'ACTIVE | RELEASED | CONSUMED']
  created_at timestamptz [not null, default: `now()`]
  released_at timestamptz

  Indexes {
    (external_installment_id) [unique, name: 'uq_active_installment_reservation', note: 'WHERE status = ACTIVE']
  }
}

Table platform.operation_events {
  id uuid [pk]
  operation_id uuid [not null, ref: > platform.portability_operations.id]
  sequence_no integer [not null, note: 'CHECK >= 1']
  event_type text [not null]
  description text [not null]
  correlation_id text [not null]
  payload_redacted jsonb [not null, default: `'{}'`]
  occurred_at timestamptz [not null]

  Note: 'Append-only audit — authoritative with DB state'

  Indexes {
    (operation_id, sequence_no) [unique, name: 'uq_operation_event_sequence']
    (operation_id, sequence_no) [name: 'idx_operation_events_operation']
  }
}

Table platform.idempotency_keys {
  id uuid [pk]
  scope text [not null]
  idempotency_key text [not null]
  request_hash text [not null, note: 'Canonical payload hash; mismatch → 409']
  operation_id uuid [ref: > platform.portability_operations.id]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (scope, idempotency_key) [unique, name: 'uq_idempotency_scope_key']
  }
}

Table platform.processing_jobs {
  id uuid [pk]
  operation_id uuid [not null, ref: > platform.portability_operations.id]
  job_type text [not null, note: 'SUBMIT / POLL']
  technical_status text [not null, note: 'PENDING | RUNNING | SUCCEEDED | FAILED | EXHAUSTED']
  attempt_count integer [not null, default: 0]
  lease_owner text
  lease_until timestamptz
  fence_token bigint [not null, default: 0]
  next_run_at timestamptz [not null]
  last_error text
  last_error_code text [note: 'V4 typed integration failure']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (next_run_at, id) [name: 'idx_jobs_claimable', note: 'WHERE technical_status IN (PENDING, FAILED, RUNNING)']
  }
}

// =============================================================================
// central.* — Flyway V2 + V7 (+ seed migrations; live verified 2026-11-26)
// SQL table names match (installment_reservations, idempotency_keys) within central DB.
// =============================================================================

TableGroup central_db [color: #10B981] {
  Note: 'Compose service central-db'
  central.authorizations
  central.agenda_installments
  central.portability_protocols
  central.protocol_installments
  central.installment_reservations
  central.idempotency_keys
  central.seen_nonces
}

Table central.authorizations {
  id uuid [pk]
  beneficiary_id text [not null, note: 'Opaque synthetic id (not platform UUID)']
  agreement_id text [not null]
  authorization_id text [not null, unique]
  status text [not null, note: 'ACCEPTED | REJECTED']
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (beneficiary_id, agreement_id) [unique, name: 'uq_authorization_beneficiary_agreement']
  }
}

Table central.agenda_installments {
  id uuid [pk]
  external_installment_id text [not null, unique]
  beneficiary_id text [not null]
  agreement_id text [not null]
  amount numeric(19,2) [not null, note: 'CHECK amount >= 0']
  discount_date date [not null]
  status text [not null, note: 'OPEN | RESERVED | PORTED | CLOSED']
  effective_bank text [note: 'V7 — update only on verified confirm']
  effective_agency text
  effective_account text

  Note: 'Seed inventory after V11: ben-ui, ben-001 (+load), fault/recover'
}

Table central.portability_protocols {
  id uuid [pk]
  protocol text [not null, unique]
  beneficiary_id text [not null]
  assignee_creditor text [not null]
  receiving_bank text [not null]
  receiving_agency text [not null]
  receiving_account text [not null]
  business_status text [not null, note: 'PENDENTE | CONFIRMADA | REJEITADA']
  rejection_reason text
  fault_mode text [not null, default: 'NONE']
  confirm_after timestamptz
  correlation_id text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table central.protocol_installments {
  protocol_id uuid [not null, ref: > central.portability_protocols.id]
  external_installment_id text [not null]

  Indexes {
    (protocol_id, external_installment_id) [pk]
  }
}

Table central.installment_reservations {
  id uuid [pk]
  external_installment_id text [not null]
  protocol_id uuid [not null, ref: > central.portability_protocols.id]
  status text [not null, note: 'ACTIVE | RELEASED | CONSUMED']
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (external_installment_id) [unique, name: 'uq_central_active_reservation', note: 'WHERE status = ACTIVE']
  }
}

Table central.idempotency_keys {
  id uuid [pk]
  scope text [not null]
  idempotency_key text [not null]
  request_hash text [not null]
  protocol_id uuid [ref: > central.portability_protocols.id]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (scope, idempotency_key) [unique, name: 'uq_central_idempotency']
  }
}

Table central.seen_nonces {
  nonce text [pk]
  seen_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]

  Indexes {
    (expires_at) [name: 'idx_seen_nonces_expires']
  }
}

// Logical cross-database associations (not enforceable FKs).
// Author: Douglas Morais (mrdouglasmorais) — links for operators / dbdiagram, not shared transactions.
Ref: platform.installment_snapshots.external_installment_id - central.agenda_installments.external_installment_id
Ref: platform.portability_operations.central_protocol - central.portability_protocols.protocol
Ref: platform.beneficiaries.external_ref - central.agenda_installments.beneficiary_id
// correlation_id is operational (MDC / X-Correlation-Id / operation_events), not a FK column pair.

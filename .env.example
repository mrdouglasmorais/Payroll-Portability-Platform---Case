# Local development — synthetic secrets only
CENTRAL_BASE_URL=http://localhost:8081
CENTRAL_HMAC_SECRET=local-test-hmac-secret
CENTRAL_HMAC_KEY_ID=local-test-key
CENTRAL_CONFIRM_DELAY=PT2S

# Platform PostgreSQL
PLATFORM_DB_URL=jdbc:postgresql://localhost:5432/portability
PLATFORM_DB_USER=portability
PLATFORM_DB_PASSWORD=portability

# Central PostgreSQL
CENTRAL_DB_URL=jdbc:postgresql://localhost:5433/central
CENTRAL_DB_USER=central
CENTRAL_DB_PASSWORD=central

# Apps
PORTABILITY_API_PORT=8080
CENTRAL_SIMULATOR_PORT=8081
WEB_PORT=5173
